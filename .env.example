# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required, no default. Must be 32+ random characters; production refuses to
# start with a short or known-weak key (see app/core/config.py).
SECRET_KEY=change-me

# JWT signing algorithm. Must be HS256, HS384 or HS512.
ALGORITHM=HS256

# Access token lifetime in minutes. There are no refresh tokens; users sign
# in again once this expires.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SQLite for local dev; use postgresql+psycopg2://user:pw@host/db in production.
DATABASE_URL=sqlite:///./auth.db

# "development" or "production". production disables /docs, enables HSTS,
# and refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development

# Comma-separated IPs/CIDRs of your reverse proxies, e.g. 127.0.0.1,10.0.0.0/8
# X-Forwarded-For is only trusted from these; leave empty to use the direct
# peer address only. Run uvicorn with --no-proxy-headers alongside this.
TRUSTED_PROXIES=

# Failures from one IP within FAILURE_WINDOW_SECONDS before that IP is
# blocked, and how long the block lasts (seconds).
IP_MAX_FAILURES=10
IP_BLOCK_SECONDS=300

# Failures against one username (from any IP) within FAILURE_WINDOW_SECONDS
# before that account is locked, and how long the lock lasts (seconds).
# This is what stops credential-stuffing botnets that spread attempts
# across many source IPs.
ACCOUNT_MAX_FAILURES=5
ACCOUNT_LOCK_SECONDS=300

# A failure older than this (seconds) stops counting toward IP/account
# thresholds above, so occasional typos don't accumulate into a lockout.
FAILURE_WINDOW_SECONDS=900
